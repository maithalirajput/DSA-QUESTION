class Solution {
    public ListNode middleNode(ListNode head) {
        ListNode hare = head;
        ListNode turtle = head;
        while(hare.next!=null && hare.next.next!=null){
            hare = hare.next.next;
            turtle = turtle.next;
        }
        if(size(head)%2==0){
            return turtle.next;
        }
        return turtle;   
    }
    public int size(ListNode head){
        int c=0;
        ListNode temp =head;
        while(temp!=null){
            c++;
            temp = temp.next;
        }
        return c;
    }
}
