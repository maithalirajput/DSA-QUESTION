class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int max = Arrays.stream(piles).max().getAsInt();
        int low = 1;
        int high = max;
        while(low<=high){
            int mid = low+(high-low)/2;
            int totalHrs = findHrs(piles, mid);
            if(totalHrs<=h){
                high = mid-1;
            }
            else{
                low = mid+1;
            }
        }
        return low;
        
    }
    public int findHrs(int[] arr, int perhour){
        int totalHrs = 0;
        for(int i=0;i<arr.length;i++){
            totalHrs += Math.ceil((double)arr[i]/(double)perhour);
        }
        return totalHrs;
    }
}
