class Solution {
    public int aggressiveCows(int[] stalls, int k) {
        // code here
        int n = stalls.length;
        Arrays.sort(stalls);
        int st = 1;
        int end = stalls[n-1]-stalls[0];
        int ans = -1;
        
        while(st<=end){
            int mid = st + (end-st)/2;
            
            if(isPossible(stalls, mid, k)){
                ans = mid;
                st = mid + 1;
            }
            else{
                end = mid - 1;
            }
        }
        return ans;
    }
    
    public boolean isPossible(int[] stalls, int minAllowedDist, int c){
        int cows = 1;
        int lastStallPos = stalls[0];
        
        for(int i=1;i<stalls.length;i++){
            if(stalls[i] - lastStallPos >= minAllowedDist) {
                cows++;
                lastStallPos = stalls[i];
            }
            if(cows == c){
                return true;
            }
        }
        return false;
    }
}
