class Solution {
    public boolean isAnagram(String s, String t) {
        if(s.length()!=t.length()){
            return false;
        }
        for(int i=0;i<s.length();i++){
            char ch = s.charAt(i);
            if(!t.contains(Character.toString(ch))){
                return false;
            }
        }
        return true;
        
    }
}
