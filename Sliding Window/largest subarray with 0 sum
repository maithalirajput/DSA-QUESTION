class Solution {
    int maxLength(int arr[]) {
        // code here
        int n = arr.length;
        HashMap<Integer, Integer> map = new HashMap<>();
        int prefix = 0;
        int maxLen = 0;

        for (int i = 0; i < n; i++) {
            prefix += arr[i];

            // Case 1: Prefix sum is zero
            if (prefix == 0) {
                maxLen = i + 1;
            }

            // Case 2: Prefix sum seen before
            if (map.containsKey(prefix)) {
                maxLen = Math.max(maxLen, i - map.get(prefix));
            } else {
                // Store first occurrence
                map.put(prefix, i);
            }
        }
        return maxLen;
    }
}
